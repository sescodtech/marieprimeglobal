// MariePrime Global Services — Database Schema
// Covers all phases of the platform: auth, CMS, enquiries, SEO, media.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Phase 2 — Admin auth
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
}

// ---------------------------------------------------------------------------
// Phase 2/3 — CMS content
// ---------------------------------------------------------------------------

// Generic key/value site settings: hero copy, mission/vision/values,
// contact details, social links, WhatsApp number, etc. One row per key
// keeps the admin UI simple (a settings form per section) without needing
// a new table for every editable string.
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  group     String // e.g. "home_hero", "about", "contact", "social"
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  routeCode   String // short boarding-pass-style code, e.g. "MPG-VISA"
  routeFrom   String // boarding-pass "from" label, e.g. "LOS"
  routeTo     String // boarding-pass "to" label, e.g. "ANY"
  summary     String
  description String   @db.Text // used as the detail-page "Overview" section
  tagline     String? // short line shown under the H1 on the detail page
  benefits    Json? // ServiceBenefit[] — { title, description }[]
  process     Json? // ServiceProcessStep[] — { step, title, description }[]
  faqs        Json? // ServiceFaq[] — { question, answer }[]
  icon        String? // icon key rendered on the frontend
  imageUrl    String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  category        String
  title           String
  excerpt         String   @db.Text
  content         String?  @db.Text // reserved for Phase 5 rich-text body
  readTime        String
  publishedLabel  String // display-only date label, e.g. "June 2026"
  isPublished     Boolean  @default(true)
  order           Int      @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  REJECTED
}

model JobApplication {
  id             String            @id @default(cuid())
  jobListing     JobListing?       @relation(fields: [jobListingId], references: [id], onDelete: SetNull)
  jobListingId   String?
  jobTitle       String // snapshot — kept even if the job listing is later edited or removed
  fullName       String
  email          String
  phone          String
  message        String?           @db.Text
  cvUrl          String
  coverLetterUrl String?
  status         ApplicationStatus @default(NEW)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model JobListing {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  department  String
  location    String
  type        String // e.g. "Full-time", "Contract"
  summary     String   @db.Text
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  applications JobApplication[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id          String   @id @default(cuid())
  category    String // e.g. "General", "Visa & Immigration"
  question    String
  answer      String   @db.Text
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  clientRole  String? // e.g. "Study Abroad Client, 2025"
  quote       String   @db.Text
  photoUrl    String?
  rating      Int      @default(5)
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DirectorProfile {
  id         String   @id @default(cuid())
  name       String
  position   String
  biography  String   @db.Text
  photoUrl   String?
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 3 — Media library
// ---------------------------------------------------------------------------

model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  cloudinaryId String
  altText      String?
  fileName     String
  fileType     String
  width        Int?
  height       Int?
  uploadedAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Phase 4 — Enquiry management
// ---------------------------------------------------------------------------

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
}

enum ServiceInterest {
  FLIGHT_BOOKING
  VISA_IMMIGRATION
  TRAVEL_LOAN
  STUDY_ABROAD
  BUSINESS_REGISTRATION
  GENERAL_ENQUIRY
}

model Enquiry {
  id              String          @id @default(cuid())
  fullName        String
  email           String
  phone           String
  serviceInterest ServiceInterest @default(GENERAL_ENQUIRY)
  message         String          @db.Text
  status          EnquiryStatus   @default(NEW)
  adminNote       String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 5 — SEO settings (per-page overrides)
// ---------------------------------------------------------------------------

model SeoSetting {
  id              String   @id @default(cuid())
  page            String   @unique // "home" | "about" | "services" | "contact" | "blog" | "careers" | "faq"
  metaTitle       String
  metaDescription String
  keywords        String? // comma-separated
  ogImageUrl      String?
  updatedAt       DateTime @updatedAt
}
