// MariePrime Global Services — Database Schema
// Covers all phases of the platform: auth, CMS, enquiries, SEO, media.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Phase 2 — Admin auth
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

model Admin {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  passwordHash    String
  role            AdminRole   @default(STAFF)
  status          AdminStatus @default(ACTIVE)
  // Grants an ADMIN (never a STAFF) permission to create/edit/suspend other
  // ADMIN accounts. Ignored for SUPER_ADMIN, who can always manage anyone.
  canManageAdmins Boolean     @default(false)
  suspendedAt     DateTime?
  // Self-relation so every account (except the original Super Admin) records
  // who created it — used for the audit trail, not for permissions.
  createdBy       Admin?      @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById     String?
  createdAdmins   Admin[]     @relation("AdminCreatedBy")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lastLoginAt     DateTime?

  // Profile (Phase 3.5) — self-service for any admin; recoveryEmail is
  // Super-Admin-editable only, same as the primary login email.
  phone         String?
  avatarUrl     String?
  recoveryEmail String?

  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  assignedApplications ServiceApplication[]
  applicationNotes     ApplicationNote[]
  assignedEnquiries    Enquiry[]
  enquiryNotes         EnquiryNote[]
  permissionGrants     AdminPermissionGrant[]
}

// Dynamic, database-backed permission grants (Phase 3.5) — the source of
// truth for what an ADMIN or STAFF account can do, replacing the old
// hardcoded role -> permission map. SUPER_ADMIN bypasses this entirely and
// always has every permission; it's the one deliberately-hardcoded
// exception, per spec ("Super Admin remains the only unrestricted account").
model AdminPermissionGrant {
  id         String   @id @default(cuid())
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId    String
  permission String
  createdAt  DateTime @default(now())

  @@unique([adminId, permission])
  @@index([adminId])
}

// Single-use, time-limited tokens for the "Forgot password" flow. A row is
// created when a reset is requested and deleted/marked used once redeemed,
// so a leaked or old email link can never be replayed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

// ---------------------------------------------------------------------------
// Phase 2/3 — CMS content
// ---------------------------------------------------------------------------

// Generic key/value site settings: hero copy, mission/vision/values,
// contact details, social links, WhatsApp number, etc. One row per key
// keeps the admin UI simple (a settings form per section) without needing
// a new table for every editable string.
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  group     String // e.g. "home_hero", "about", "contact", "social"
  updatedAt DateTime @updatedAt
}

enum ServiceApplicationMode {
  APPLY_ONLY
  ENQUIRY_ONLY
  APPLY_AND_ENQUIRY
  HIDDEN
}

enum ServiceStatus {
  ACTIVE
  CLOSED
  MAINTENANCE
  COMING_SOON
}

enum ApplyRedirectTarget {
  CONTACT
  ENQUIRY
  SERVICE_DETAILS
  CUSTOM
}

model Service {
  id              String                 @id @default(cuid())
  slug            String                 @unique
  title           String
  routeCode       String // short boarding-pass-style code, e.g. "MPG-VISA"
  routeFrom       String // boarding-pass "from" label, e.g. "LOS"
  routeTo         String // boarding-pass "to" label, e.g. "ANY"
  summary         String
  description     String                 @db.Text // used as the detail-page "Overview" section
  tagline         String? // short line shown under the H1 on the detail page
  benefits        Json? // ServiceBenefit[] — { title, description }[]
  process         Json? // ServiceProcessStep[] — { step, title, description }[]
  faqs            Json? // ServiceFaq[] — { question, answer }[]
  requirements    Json? // string[] — plain-language list of what a client needs to apply
  processingTime  String? // e.g. "3–5 business days"
  applicationMode ServiceApplicationMode @default(APPLY_ONLY)
  status          ServiceStatus          @default(ACTIVE)
  showApplyButton Boolean                @default(true)
  showEnquiryButton Boolean              @default(true)
  applyRedirect     ApplyRedirectTarget  @default(SERVICE_DETAILS)
  applyRedirectUrl  String?
  icon            String? // icon key rendered on the frontend
  imageUrl        String?
  bannerUrl       String?
  order           Int                    @default(0)
  isPublished     Boolean                @default(true)
  isArchived      Boolean                @default(false)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  category        String
  title           String
  excerpt         String   @db.Text
  content         String?  @db.Text // reserved for Phase 5 rich-text body
  readTime        String
  publishedLabel  String // display-only date label, e.g. "June 2026"
  isPublished     Boolean  @default(true)
  order           Int      @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  REJECTED
}

model JobApplication {
  id             String            @id @default(cuid())
  jobListing     JobListing?       @relation(fields: [jobListingId], references: [id], onDelete: SetNull)
  jobListingId   String?
  jobTitle       String // snapshot — kept even if the job listing is later edited or removed
  fullName       String
  email          String
  phone          String
  message        String?           @db.Text
  cvUrl          String
  coverLetterUrl String?
  status         ApplicationStatus @default(NEW)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  status         SubscriberStatus @default(SUBSCRIBED)
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())

  recipientRecords NewsletterRecipient[]
}

enum NewsletterStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model Newsletter {
  id             String           @id @default(cuid())
  subject        String
  message        String           @db.Text
  status         NewsletterStatus @default(DRAFT)
  scheduledFor   DateTime?
  sentAt         DateTime?
  recipientCount Int              @default(0)
  sentCount      Int              @default(0)
  failedCount    Int              @default(0)
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  recipients NewsletterRecipient[]
}

enum NewsletterRecipientStatus {
  PENDING
  SENT
  FAILED
}

model NewsletterRecipient {
  id           String                    @id @default(cuid())
  newsletter   Newsletter                @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  newsletterId String
  subscriber   NewsletterSubscriber      @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  subscriberId String
  status       NewsletterRecipientStatus @default(PENDING)
  sentAt       DateTime?
  error        String?

  @@unique([newsletterId, subscriberId])
  @@index([newsletterId])
}

model JobListing {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  department  String
  location    String
  type        String // e.g. "Full-time", "Contract"
  summary     String   @db.Text
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  applications JobApplication[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id          String   @id @default(cuid())
  category    String // e.g. "General", "Visa & Immigration"
  question    String
  answer      String   @db.Text
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  clientRole  String? // e.g. "Study Abroad Client, 2025"
  quote       String   @db.Text
  photoUrl    String?
  rating      Int      @default(5)
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DirectorProfile {
  id         String   @id @default(cuid())
  name       String
  position   String
  biography  String   @db.Text
  photoUrl   String?
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 3 — Media library
// ---------------------------------------------------------------------------

model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  cloudinaryId String
  altText      String?
  fileName     String
  fileType     String
  width        Int?
  height       Int?
  uploadedAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Phase 4 — Enquiry management
// ---------------------------------------------------------------------------

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum ServiceInterest {
  FLIGHT_BOOKING
  VISA_IMMIGRATION
  TRAVEL_LOAN
  STUDY_ABROAD
  BUSINESS_REGISTRATION
  HOTEL_RESERVATION
  TRAVEL_INSURANCE
  LOGISTICS
  PROCUREMENT
  EVENT_COORDINATION
  BEAUTY_SERVICES
  GENERAL_ENQUIRY
}

model Enquiry {
  id              String          @id @default(cuid())
  fullName        String
  email           String
  phone           String
  serviceInterest ServiceInterest @default(GENERAL_ENQUIRY)
  subject         String? // added Phase 3 — nullable so existing rows aren't broken; new submissions always set it
  message          String          @db.Text
  status          EnquiryStatus   @default(NEW)
  adminNote       String?         @db.Text // legacy single-note field, kept for old data — new notes use EnquiryNote below
  assignedStaff   Admin?          @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedStaffId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  notes EnquiryNote[]
}

model EnquiryNote {
  id         String   @id @default(cuid())
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  enquiryId  String
  author     Admin?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?
  authorName String
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([enquiryId])
}

// ---------------------------------------------------------------------------
// Phase 5 — SEO settings (per-page overrides)
// ---------------------------------------------------------------------------

model SeoSetting {
  id              String   @id @default(cuid())
  page            String   @unique // "home" | "about" | "services" | "visa" | "contact" | "blog" | "careers" | "faq"
  metaTitle       String
  metaDescription String
  keywords        String? // comma-separated
  canonicalUrl    String?
  ogImageUrl      String?
  twitterImageUrl String?
  noIndex         Boolean  @default(false)
  noFollow        Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 6 — Enterprise RBAC: audit log & notification scaffold
// ---------------------------------------------------------------------------

// Append-only record of every sensitive action taken in the admin dashboard
// (logins, logouts, user management, role changes). Snapshots the actor's
// name/email/role at the time of the action so the trail stays readable even
// if that account is later renamed, role-changed, or deleted.
model AuditLog {
  id          String   @id @default(cuid())
  actor       Admin?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId     String?
  actorName   String
  actorEmail  String
  actorRole   String
  action      String // e.g. "LOGIN", "USER_CREATED", "ROLE_CHANGED", "USER_SUSPENDED"
  entityType  String? // e.g. "Admin"
  entityId    String?
  description String?  @db.Text
  ipAddress   String?
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

// Notification architecture is intentionally scaffolded only in this phase —
// no channel is wired up to actually send yet. This reserves the data model
// now so Email, System, SMS and WhatsApp notifications can be turned on in a
// later phase without another migration.
enum NotificationChannel {
  EMAIL
  SYSTEM
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id               String              @id @default(cuid())
  recipient        Admin?              @relation(fields: [recipientAdminId], references: [id], onDelete: Cascade)
  recipientAdminId String?
  channel          NotificationChannel @default(SYSTEM)
  status           NotificationStatus  @default(PENDING)
  title            String
  body             String              @db.Text
  link             String? // e.g. /admin/applications/{id} — where clicking the notification goes
  category         String              @default("SYSTEM") // Applications | Enquiries | Documents | Newsletter | Users | Media | Settings | Security | AuditLogs | System
  isRead           Boolean             @default(false)
  readAt           DateTime?
  metadata         Json?
  createdAt        DateTime            @default(now())
  sentAt           DateTime?

  @@index([recipientAdminId])
  @@index([recipientAdminId, isRead])
  @@index([recipientAdminId, category])
}

// ---------------------------------------------------------------------------
// Phase 2 — Client Application Portal
// ---------------------------------------------------------------------------

enum ServiceApplicationType {
  VISA
  PROOF_OF_FUNDS
  FLIGHT_BOOKING
  HOTEL_RESERVATION
  TRAVEL_INSURANCE
  LOGISTICS
  PROCUREMENT
  EVENT_COORDINATION
  BEAUTY_SERVICES
}

enum ServiceApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_DOCS_REQUIRED
  DOCUMENTS_RECEIVED
  PROCESSING
  APPROVED
  REJECTED
  COMPLETED
}

// One row per client application submitted through the public /apply flow.
// `formData` holds the full dynamic-form payload (keyed by field id, as
// defined in src/lib/applicationForms/config.ts) so every service's form can
// share one table without a migration per service.
model ServiceApplication {
  id              String                   @id @default(cuid())
  referenceNumber String                   @unique
  serviceType     ServiceApplicationType
  serviceTitle    String // snapshot of the service's display name at submission time
  status          ServiceApplicationStatus @default(SUBMITTED)
  applicantName   String
  applicantEmail  String
  applicantPhone  String
  formData        Json
  assignedStaff   Admin?                   @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedStaffId String?
  // Secure, tokenized link sent to the client when additional documents are
  // requested — lets them upload without an account. Regenerated (and the
  // old one invalidated) each time additional documents are requested.
  uploadToken          String?   @unique
  uploadTokenExpiresAt DateTime?
  submittedAt     DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  documents     ApplicationDocument[]
  statusHistory ApplicationStatusEvent[]
  notes         ApplicationNote[]

  @@index([status])
  @@index([serviceType])
  @@index([applicantEmail])
}

model ApplicationDocument {
  id            String             @id @default(cuid())
  application   ServiceApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  docType       String // e.g. "validId", "utilityBill", "passportPhoto", "signature", "supportingDocument"
  label         String
  fileUrl       String
  publicId      String? // Cloudinary public_id — lets a document be deleted from storage, not just unlinked
  mimeType      String?
  createdAt     DateTime           @default(now())

  @@unique([applicationId, docType])
  @@index([applicationId])
}

// Append-only timeline shown both in the admin detail page and on the public
// tracking page (minus any internal-only notes).
model ApplicationStatusEvent {
  id            String                   @id @default(cuid())
  application   ServiceApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  status        ServiceApplicationStatus
  note          String?                  @db.Text
  actorName     String? // null = automated/system event (e.g. initial submission)
  createdAt     DateTime                 @default(now())

  @@index([applicationId])
}

model ApplicationNote {
  id            String             @id @default(cuid())
  application   ServiceApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  author        Admin?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId      String?
  authorName    String
  body          String             @db.Text
  // Public notes surface on the client-facing tracking page; everything else
  // is internal-only, per the "Internal Notes" / "Public Notes" distinction.
  isPublic      Boolean            @default(false)
  createdAt     DateTime           @default(now())

  @@index([applicationId])
}

// Backs the MPG-{year}-{000001} reference number sequence. One row per year,
// incremented atomically so numbers are never duplicated or skipped oddly.
model ReferenceCounter {
  year  Int @id
  count Int @default(0)
}

// ---------------------------------------------------------------------------
// Phase 3 — configurable per-service document requirements
// ---------------------------------------------------------------------------

// Keyed by ServiceApplicationType rather than a Service row's id, since one
// service (Proof of Funds) has no matching CMS Service page at all. This is
// what lets a Super Admin add/remove/reconfigure documents for any service
// from the dashboard — the wizard and submit route both read from here
// first, falling back to the built-in defaults in
// src/lib/applicationForms/config.ts only if nothing's been configured yet.
model ServiceDocumentRequirement {
  id          String                 @id @default(cuid())
  serviceType ServiceApplicationType
  // Stable key stored on ApplicationDocument.docType — do not change this on
  // an existing row once applications have been submitted against it.
  docKey      String
  name        String
  description String?                @db.Text
  isRequired  Boolean                @default(true)
  fileTypes   String                 @default("image/jpeg,image/png,application/pdf")
  maxSizeMb   Int                    @default(8)
  order       Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([serviceType, docKey])
  @@index([serviceType])
}

// ---------------------------------------------------------------------------
// Phase 3.5 — Email template management
// ---------------------------------------------------------------------------

// One row per email "kind" the system sends. Super Admin can edit
// subject/body with {{variables}}; sendX() helpers in src/lib/email.ts check
// here first and fall back to the built-in copy if nothing's configured yet
// — the same safe-fallback pattern used for ServiceDocumentRequirement.
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "APPLICATION_RECEIVED", "PASSWORD_RESET"
  name      String // human label shown in the admin UI
  subject   String
  bodyHtml  String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Phase 4 — Popup Manager, Announcement Bar
// ---------------------------------------------------------------------------

enum PopupType {
  PROMOTION
  NEWSLETTER
  TRAVEL_UPDATE
  VISA_UPDATE
  HOLIDAY_NOTICE
  INFORMATION
  GENERAL_ANNOUNCEMENT
}

enum PopupDisplayRule {
  ENTIRE_WEBSITE
  HOMEPAGE_ONLY
  SPECIFIC_PAGE
  SPECIFIC_SERVICE
  SPECIFIC_BLOG
}

enum PopupTriggerRule {
  AFTER_SECONDS
  AFTER_SCROLL_PERCENT
  EXIT_INTENT
  FIRST_VISIT
  ONCE_PER_SESSION
  ALWAYS
}

model Popup {
  id           String           @id @default(cuid())
  title        String
  subtitle     String?
  description  String?          @db.Text
  buttonText   String?
  buttonLink   String?
  imageUrl     String?
  bgColor      String           @default("#0B0F1A")
  textColor    String           @default("#FFFFFF")
  isEnabled    Boolean          @default(true)
  startDate    DateTime?
  endDate      DateTime?
  popupType    PopupType        @default(GENERAL_ANNOUNCEMENT)
  displayRule  PopupDisplayRule @default(ENTIRE_WEBSITE)
  // Holds the slug/path this popup is scoped to when displayRule is
  // SPECIFIC_PAGE / SPECIFIC_SERVICE / SPECIFIC_BLOG. Ignored otherwise.
  displayTarget String?
  triggerRule   PopupTriggerRule @default(AFTER_SECONDS)
  // Seconds for AFTER_SECONDS, percent (0-100) for AFTER_SCROLL_PERCENT.
  // Ignored for the other trigger rules.
  triggerValue  Int              @default(5)
  views         Int              @default(0)
  clicks        Int              @default(0)
  closes        Int              @default(0)
  order         Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

enum AnnouncementDisplayRule {
  ENTIRE_WEBSITE
  HOMEPAGE
  SELECTED_PAGES
}

model Announcement {
  id           String                  @id @default(cuid())
  title        String
  message      String                  @db.Text
  icon         String?
  buttonText   String?
  buttonLink   String?
  bgColor      String                  @default("#1B4332")
  textColor    String                  @default("#FFFFFF")
  priority     Int                     @default(0)
  isEnabled    Boolean                 @default(true)
  isArchived   Boolean                 @default(false)
  startDate    DateTime?
  endDate      DateTime?
  displayRule  AnnouncementDisplayRule @default(ENTIRE_WEBSITE)
  selectedPages Json? // string[] of page paths, used when displayRule = SELECTED_PAGES
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([isEnabled, isArchived])
}
