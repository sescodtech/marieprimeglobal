// MariePrime Global Services — Database Schema
// Covers all phases of the platform: auth, CMS, enquiries, SEO, media.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Phase 2 — Admin auth
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

model Admin {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  passwordHash    String
  role            AdminRole   @default(STAFF)
  status          AdminStatus @default(ACTIVE)
  // Grants an ADMIN (never a STAFF) permission to create/edit/suspend other
  // ADMIN accounts. Ignored for SUPER_ADMIN, who can always manage anyone.
  canManageAdmins Boolean     @default(false)
  suspendedAt     DateTime?
  // Self-relation so every account (except the original Super Admin) records
  // who created it — used for the audit trail, not for permissions.
  createdBy       Admin?      @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById     String?
  createdAdmins   Admin[]     @relation("AdminCreatedBy")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lastLoginAt     DateTime?

  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  assignedApplications ServiceApplication[]
  applicationNotes     ApplicationNote[]
}

// Single-use, time-limited tokens for the "Forgot password" flow. A row is
// created when a reset is requested and deleted/marked used once redeemed,
// so a leaked or old email link can never be replayed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

// ---------------------------------------------------------------------------
// Phase 2/3 — CMS content
// ---------------------------------------------------------------------------

// Generic key/value site settings: hero copy, mission/vision/values,
// contact details, social links, WhatsApp number, etc. One row per key
// keeps the admin UI simple (a settings form per section) without needing
// a new table for every editable string.
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  group     String // e.g. "home_hero", "about", "contact", "social"
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  routeCode   String // short boarding-pass-style code, e.g. "MPG-VISA"
  routeFrom   String // boarding-pass "from" label, e.g. "LOS"
  routeTo     String // boarding-pass "to" label, e.g. "ANY"
  summary     String
  description String   @db.Text // used as the detail-page "Overview" section
  tagline     String? // short line shown under the H1 on the detail page
  benefits    Json? // ServiceBenefit[] — { title, description }[]
  process     Json? // ServiceProcessStep[] — { step, title, description }[]
  faqs        Json? // ServiceFaq[] — { question, answer }[]
  icon        String? // icon key rendered on the frontend
  imageUrl    String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  category        String
  title           String
  excerpt         String   @db.Text
  content         String?  @db.Text // reserved for Phase 5 rich-text body
  readTime        String
  publishedLabel  String // display-only date label, e.g. "June 2026"
  isPublished     Boolean  @default(true)
  order           Int      @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  REJECTED
}

model JobApplication {
  id             String            @id @default(cuid())
  jobListing     JobListing?       @relation(fields: [jobListingId], references: [id], onDelete: SetNull)
  jobListingId   String?
  jobTitle       String // snapshot — kept even if the job listing is later edited or removed
  fullName       String
  email          String
  phone          String
  message        String?           @db.Text
  cvUrl          String
  coverLetterUrl String?
  status         ApplicationStatus @default(NEW)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model JobListing {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  department  String
  location    String
  type        String // e.g. "Full-time", "Contract"
  summary     String   @db.Text
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  applications JobApplication[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id          String   @id @default(cuid())
  category    String // e.g. "General", "Visa & Immigration"
  question    String
  answer      String   @db.Text
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  clientRole  String? // e.g. "Study Abroad Client, 2025"
  quote       String   @db.Text
  photoUrl    String?
  rating      Int      @default(5)
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DirectorProfile {
  id         String   @id @default(cuid())
  name       String
  position   String
  biography  String   @db.Text
  photoUrl   String?
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 3 — Media library
// ---------------------------------------------------------------------------

model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  cloudinaryId String
  altText      String?
  fileName     String
  fileType     String
  width        Int?
  height       Int?
  uploadedAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Phase 4 — Enquiry management
// ---------------------------------------------------------------------------

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
}

enum ServiceInterest {
  FLIGHT_BOOKING
  VISA_IMMIGRATION
  TRAVEL_LOAN
  STUDY_ABROAD
  BUSINESS_REGISTRATION
  GENERAL_ENQUIRY
}

model Enquiry {
  id              String          @id @default(cuid())
  fullName        String
  email           String
  phone           String
  serviceInterest ServiceInterest @default(GENERAL_ENQUIRY)
  message         String          @db.Text
  status          EnquiryStatus   @default(NEW)
  adminNote       String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 5 — SEO settings (per-page overrides)
// ---------------------------------------------------------------------------

model SeoSetting {
  id              String   @id @default(cuid())
  page            String   @unique // "home" | "about" | "services" | "contact" | "blog" | "careers" | "faq"
  metaTitle       String
  metaDescription String
  keywords        String? // comma-separated
  ogImageUrl      String?
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 6 — Enterprise RBAC: audit log & notification scaffold
// ---------------------------------------------------------------------------

// Append-only record of every sensitive action taken in the admin dashboard
// (logins, logouts, user management, role changes). Snapshots the actor's
// name/email/role at the time of the action so the trail stays readable even
// if that account is later renamed, role-changed, or deleted.
model AuditLog {
  id          String   @id @default(cuid())
  actor       Admin?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId     String?
  actorName   String
  actorEmail  String
  actorRole   String
  action      String // e.g. "LOGIN", "USER_CREATED", "ROLE_CHANGED", "USER_SUSPENDED"
  entityType  String? // e.g. "Admin"
  entityId    String?
  description String?  @db.Text
  ipAddress   String?
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

// Notification architecture is intentionally scaffolded only in this phase —
// no channel is wired up to actually send yet. This reserves the data model
// now so Email, System, SMS and WhatsApp notifications can be turned on in a
// later phase without another migration.
enum NotificationChannel {
  EMAIL
  SYSTEM
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id               String              @id @default(cuid())
  recipient        Admin?              @relation(fields: [recipientAdminId], references: [id], onDelete: Cascade)
  recipientAdminId String?
  channel          NotificationChannel @default(SYSTEM)
  status           NotificationStatus  @default(PENDING)
  title            String
  body             String              @db.Text
  metadata         Json?
  createdAt        DateTime            @default(now())
  sentAt           DateTime?

  @@index([recipientAdminId])
}

// ---------------------------------------------------------------------------
// Phase 2 — Client Application Portal
// ---------------------------------------------------------------------------

enum ServiceApplicationType {
  VISA
  PROOF_OF_FUNDS
  FLIGHT_BOOKING
  HOTEL_RESERVATION
  TRAVEL_INSURANCE
  LOGISTICS
  PROCUREMENT
  EVENT_COORDINATION
  BEAUTY_SERVICES
}

enum ServiceApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_DOCS_REQUIRED
  DOCUMENTS_RECEIVED
  PROCESSING
  APPROVED
  REJECTED
  COMPLETED
}

// One row per client application submitted through the public /apply flow.
// `formData` holds the full dynamic-form payload (keyed by field id, as
// defined in src/lib/applicationForms/config.ts) so every service's form can
// share one table without a migration per service.
model ServiceApplication {
  id              String                   @id @default(cuid())
  referenceNumber String                   @unique
  serviceType     ServiceApplicationType
  serviceTitle    String // snapshot of the service's display name at submission time
  status          ServiceApplicationStatus @default(SUBMITTED)
  applicantName   String
  applicantEmail  String
  applicantPhone  String
  formData        Json
  assignedStaff   Admin?                   @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedStaffId String?
  submittedAt     DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  documents     ApplicationDocument[]
  statusHistory ApplicationStatusEvent[]
  notes         ApplicationNote[]

  @@index([status])
  @@index([serviceType])
  @@index([applicantEmail])
}

model ApplicationDocument {
  id            String             @id @default(cuid())
  application   ServiceApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  docType       String // e.g. "validId", "utilityBill", "passportPhoto", "signature", "supportingDocument"
  label         String
  fileUrl       String
  publicId      String? // Cloudinary public_id — lets a document be deleted from storage, not just unlinked
  mimeType      String?
  createdAt     DateTime           @default(now())

  @@index([applicationId])
}

// Append-only timeline shown both in the admin detail page and on the public
// tracking page (minus any internal-only notes).
model ApplicationStatusEvent {
  id            String                   @id @default(cuid())
  application   ServiceApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  status        ServiceApplicationStatus
  note          String?                  @db.Text
  actorName     String? // null = automated/system event (e.g. initial submission)
  createdAt     DateTime                 @default(now())

  @@index([applicationId])
}

model ApplicationNote {
  id            String             @id @default(cuid())
  application   ServiceApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  author        Admin?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId      String?
  authorName    String
  body          String             @db.Text
  // Public notes surface on the client-facing tracking page; everything else
  // is internal-only, per the "Internal Notes" / "Public Notes" distinction.
  isPublic      Boolean            @default(false)
  createdAt     DateTime           @default(now())

  @@index([applicationId])
}

// Backs the MPG-{year}-{000001} reference number sequence. One row per year,
// incremented atomically so numbers are never duplicated or skipped oddly.
model ReferenceCounter {
  year  Int @id
  count Int @default(0)
}
